{
  "manifest_version": 3,
  "name": "Docs Outline Panel",
  "version": "0.1.1",
  "description": "A resizable outline for Google Docs that shows full heading text.",
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["content.js"],
      "css": ["page.css"],
      "run_at": "document_start"
    }
  ]
}
